# Copy this file to bot/app/.env and fill in real values.

# Telegram bot
BOT_TOKEN=
BOT_TOKEN_DEV=
IS_DEVELOPMENT=false
BOT_ADMINS=
DEBUG=false

# Algolia
ALGOLIA_APP_ID=
ALGOLIA_BACKEND_API_KEY=
ALGOLIA_INDEX_NAME=

# PostgreSQL
POSTGRES_DB=fm
POSTGRES_USER=fm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional observability
SENTRY_DSN=

# Optional scheduler storage location
SCHEDULER_DB_PATH=/tmp/fm_jobs.sqlite
